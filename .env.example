# ─────────────────────────────────────────────────────────────
# KIP Portal — root environment template
# Copy to .env and fill in values. Per-app envs live in apps/*/.env
# ─────────────────────────────────────────────────────────────

# Postgres (used by docker-compose + @kip/db)
POSTGRES_USER=kip
POSTGRES_PASSWORD=kip_dev_password
POSTGRES_DB=kip_portal
DATABASE_URL=postgresql://kip:kip_dev_password@localhost:5432/kip_portal?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me_openssl_rand_base64_32

# Email (MailHog in dev)
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="KIP Portal <no-reply@unoc.local>"

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Storage (S3 / Cloudflare R2) — leave blank in dev to use local fs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=kip-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# n8n webhooks
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=replace_me_shared_secret

# Anthropic (internal AI screening — NEVER referenced in external UI)
ANTHROPIC_API_KEY=

# Payment gateway (placeholder for Visa/Mastercard processor)
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Business config
EOI_APPLICATION_FEE_USD=1000
EOI_APPLICATION_FEE_UGX=500000
