# Copy to /opt/kip/.env.production on the server and fill in real values.
# NOTE: docker compose reads these values LITERALLY — no ${VAR} interpolation.
# DATABASE_URL must therefore repeat the postgres password in full.

# ── Shared ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# MUST be identical for web, portal and api (they verify each other's JWTs).
NEXTAUTH_SECRET=

# Parent domain for the NextAuth session cookie, with a leading dot. Lets the
# cookie set on portal.kip.unoc.com / kip.unoc.com be sent to api.kip.unoc.com;
# without it, browser API calls fail with 401 "Missing session token". Read by
# the web + portal apps only. Leave UNSET for local dev (cookie stays host-only).
COOKIE_DOMAIN=.kip.unoc.com

# ── Postgres (container bootstrap + app connection) ───────
POSTGRES_USER=kip
POSTGRES_PASSWORD=
POSTGRES_DB=kip_portal
# Same password as POSTGRES_PASSWORD, written out in full.
# ?sslmode=disable is REQUIRED: packages/db/src/ssl.ts treats any non-local
# host (including the compose service name "postgres") as hosted Postgres
# needing TLS — the plain postgres:16 container has no SSL, so migrations
# and the apps fail with "The server does not support SSL connections".
DATABASE_URL=postgresql://kip:CHANGE_ME@postgres:5432/kip_portal?sslmode=disable

# ── API ───────────────────────────────────────────────────
NODE_ENV=production
API_PORT=4001
LOG_LEVEL=info
# CORS origins — the two browser-facing hosts
WEB_PUBLIC_URL=https://portal.kip.unoc.com
PORTAL_PUBLIC_URL=https://kip.unoc.com
# n8n webhooks (internal). Uncomment BOTH lines once workflows are configured.
# N8N_WEBHOOK_SECRET must be >= 8 chars — an EMPTY value crashes API startup,
# so keep these commented out until you have a real secret. Webhooks no-op
# while they are absent.
# N8N_BASE_URL=http://n8n:5678
# N8N_WEBHOOK_SECRET=

# ── S3 (documents) ────────────────────────────────────────
# Leave S3_ENDPOINT empty for real AWS S3.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=kip-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Portals ───────────────────────────────────────────────
# NEXTAUTH_URL is set per-service in docker-compose.prod.yml (differs per app).
# These two only affect server-side code at runtime — the client bundle got
# them at image build time from the GitHub Actions build args. Keep in sync.
NEXT_PUBLIC_API_URL=https://api.kip.unoc.com
NEXT_PUBLIC_PORTAL_URL=https://kip.unoc.com
# Google Tag Manager container (public id). GTM is a client-side tag, so this
# runtime value changes nothing on its own — the id that actually loads was
# baked in at image build time from the NEXT_PUBLIC_GTM_ID build arg.
NEXT_PUBLIC_GTM_ID=GTM-T23BP8QS

# ── Email — Office 365 SMTP submission ────────────────────
# The mailbox needs SMTP AUTH enabled and must be exempt from MFA/security
# defaults (basic auth). EMAIL_FROM must be the authenticated mailbox or a
# permitted Send As alias, or Exchange rejects with 5.7.60.
# Throttle: ~30 messages/minute, 10,000 recipients/day.
# Leave EMAIL_SERVER_USER empty to disable auth (magic-link sign-in and the
# contact form go inactive; credentials sign-in still works).
EMAIL_SERVER_HOST=smtp.office365.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=Support.Kip@unoc.com
EMAIL_SERVER_PASSWORD=
# No quotes — env_file values are read literally, quotes would end up in the header.
EMAIL_FROM=Support KIP <Support.Kip@unoc.com>

# ── Fees ──────────────────────────────────────────────────
EOI_APPLICATION_FEE_USD=1000
EOI_APPLICATION_FEE_UGX=3700000
