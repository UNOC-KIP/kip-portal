# TLS is automatic — Caddy provisions/renews Let's Encrypt certs; the three
# A records live in the unoc.com zone (cPanel Zone Editor on Namecheap
# hosting) and point at the EC2 Elastic IP 15.240.34.84.

kip.unoc.com {
	reverse_proxy portal:4002
}

portal.kip.unoc.com {
	reverse_proxy web:4000
}

api.kip.unoc.com {
	reverse_proxy api:4001
}

# Legacy sslip.io hosts (pre-domain deployment, July 2026) — permanent
# redirects so old links keep working.
kip.15-240-34-84.sslip.io {
	redir https://kip.unoc.com{uri} permanent
}

