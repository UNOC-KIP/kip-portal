DATABASE_URL=postgresql://kip:kip_dev_password@localhost:5433/kip_portal?schema=public
API_PORT=4001
WEB_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=debug

# Must match NEXTAUTH_SECRET in apps/web and apps/portal — the API verifies tokens minted by both portals
NEXTAUTH_SECRET=replace_me_openssl_rand_base64_32

# n8n webhooks — omit N8N_WEBHOOK_SECRET entirely in test/dev (empty string causes Zod min(8) failure)
N8N_BASE_URL=http://localhost:5678
# N8N_WEBHOOK_SECRET=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=kip-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

ANTHROPIC_API_KEY=

EOI_APPLICATION_FEE_USD=1000
EOI_APPLICATION_FEE_UGX=3700000
