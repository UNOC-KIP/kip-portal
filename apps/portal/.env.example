DATABASE_URL=postgresql://kip:kip_dev_password@localhost:5433/kip_portal?schema=public

# Must match apps/web NEXTAUTH_SECRET and apps/api NEXTAUTH_SECRET exactly
NEXTAUTH_URL=http://localhost:4002
NEXTAUTH_SECRET=replace_me_openssl_rand_base64_32

# Local dev: MailHog (docker:up) — leave USER/PASSWORD blank.
# Real mail: Office 365 submission. EMAIL_FROM must be the authenticated mailbox
# (or a permitted Send As alias) or Exchange rejects with 5.7.60.
#   EMAIL_SERVER_HOST=smtp.office365.com
#   EMAIL_SERVER_PORT=587
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="KIP Portal <no-reply@unoc.local>"

NEXT_PUBLIC_API_URL=http://localhost:4001

# Google Tag Manager container id (public, not a secret). Leave EMPTY locally so
# dev traffic never reaches the analytics property; prod value is GTM-T23BP8QS.
NEXT_PUBLIC_GTM_ID=
